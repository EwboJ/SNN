<?xml version="1.0"?>
<!-- ROS2 Humble ament_python 包描述（最小可运行） -->
<package format="3">
  <name>snn_nav_ros</name>
  <version>0.0.1</version>
  <description>ROS2 hierarchical navigation online runtime package for SNN-based navigation.</description>

  <maintainer email="maintainer@example.com">SNN Nav Maintainer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-setuptools</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
